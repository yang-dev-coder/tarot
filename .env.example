# ─── 塔罗后端环境变量 ──────────────────────────────────────────────────────
# 复制本文件为 .env 并填入真实值，或直接设置系统环境变量。
# .env 文件已被 .gitignore 忽略，不会提交到版本库。

# LLM API Key（二选一，AgentPipeline 启动时读取）
# 智谱 AI（推荐，默认 base_url 指向智谱）
ZHIPU_AI_API_KEY=your_zhipu_api_key_here

# OpenAI 兼容接口（如使用 OpenAI 或其他兼容服务）
# OPENAI_API_KEY=your_openai_api_key_here

# LLM 接口地址（默认：智谱 AI）
# 如使用 OpenAI 官方接口：https://api.openai.com/v1/
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 模型名称（默认：glm-5.2）
# 如使用 OpenAI：gpt-4o / gpt-4o-mini 等
LLM_MODEL_NAME=glm-5.2
